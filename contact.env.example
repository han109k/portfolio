# Copy to contact.env (git-ignored) and fill in. build.sh puts these into dist/index.html.
# One KEY=value per line, no quotes needed.
EMAIL=you@example.com
GITHUB_URL=https://github.com/your-name
LINKEDIN_URL=https://www.linkedin.com/in/your-name
# cv file name in assets/, without .pdf (CV=your-name → assets/your-name.pdf)
CV=your-name
